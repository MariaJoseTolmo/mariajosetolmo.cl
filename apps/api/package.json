{
  "name": "@web-cv/api",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start:dev": "nest start --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "test:cov": "NODE_OPTIONS=--experimental-vm-modules jest --coverage",
    "keys:dev": "node scripts/dev-keys.js",
    "test:e2e": "NODE_OPTIONS=--experimental-vm-modules jest --config test/jest-e2e.config.js",
    "test:int": "NODE_OPTIONS=--experimental-vm-modules jest --config test/jest-int.config.js",
    "migration:run": "npm run build && typeorm migration:run -d dist/shared/infrastructure/persistence/data-source.cli.js",
    "migration:revert": "npm run build && typeorm migration:revert -d dist/shared/infrastructure/persistence/data-source.cli.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1147.0",
    "@aws-sdk/client-sesv2": "3.1156.0",
    "@aws-sdk/client-ssm": "3.1147.0",
    "@aws-sdk/s3-request-presigner": "3.1147.0",
    "@nestjs/common": "12.2.0",
    "@nestjs/core": "12.2.0",
    "@nestjs/platform-express": "12.2.0",
    "@nestjs/swagger": "12.0.4",
    "cookie-parser": "1.4.7",
    "ioredis": "6.0.0",
    "jose": "6.2.12",
    "nodemailer": "10.1.4",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "typeorm": "1.1.1"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.10",
    "@nestjs/testing": "12.2.0",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "jest": "30.5.2",
    "supertest": "7.3.1",
    "ts-jest": "29.4.15"
  }
}
