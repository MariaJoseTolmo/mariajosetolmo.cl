# Copy to .env for local development. Fictitious values only; never commit .env.
POSTGRES_USER=webcv
POSTGRES_PASSWORD=local-dev-only
POSTGRES_DB=webcv
# Host ports; change them if a local Postgres/Redis already uses the defaults.
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379

# --- apps/api (all fictitious; run `npm run keys:dev -w apps/api` first) ---
# Not read from this file automatically: export them or use your own loader.
PORT=3000
ALLOWED_ORIGINS=http://127.0.0.1:3001
COOKIE_SECURE=false
CLIENT_IP_SOURCE=socket
SECRETS_SOURCE=env
JWT_ISSUER=http://localhost:3000
MAGIC_LINK_BASE_URL=http://127.0.0.1:3001/acceso/verificar/
MAIL_TRANSPORT=smtp
MAIL_FROM=no-reply@example.test
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
ADMIN_EMAIL=admin@example.test
JWT_PRIVATE_KEY_FILE=apps/api/.keys/jwt-private.pem
JWT_KEY_ID=dev-key-1
REDIS_URL=redis://127.0.0.1:6379
DATABASE_URL=postgres://webcv:local-dev-only@127.0.0.1:5432/webcv
MIGRATIONS_DATABASE_URL=postgres://webcv:local-dev-only@127.0.0.1:5432/webcv
